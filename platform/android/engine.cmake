# Minimal native Player. Windows tools compile the same project's source assets first.
if(NOT GM_ANDROID_GAME_SOURCES)
  message(FATAL_ERROR "Supply -DGM_ANDROID_GAME_SOURCES=/absolute/game.cpp (semicolon separated sources supported)")
endif()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
add_library(gm_tasks STATIC src/tasks.cpp src/game_jobs.cpp src/resources.cpp)
target_include_directories(gm_tasks PUBLIC src sdk/include)
target_link_libraries(gm_tasks PUBLIC Threads::Threads)
add_library(gm_network STATIC src/network.cpp)
target_include_directories(gm_network PUBLIC src sdk/include)
add_library(gm_audio STATIC src/audio.cpp src/miniaudio.cpp)
target_include_directories(gm_audio PUBLIC src sdk/include PRIVATE third_party/miniaudio)
target_link_libraries(gm_audio PRIVATE android log dl Threads::Threads)
add_library(gm_storage STATIC src/storage.cpp)
target_include_directories(gm_storage PUBLIC src sdk/include)
target_link_libraries(gm_storage PUBLIC gm_tasks gm_network gm_audio)
add_library(gm_registry STATIC src/game_registry.cpp)
target_include_directories(gm_registry PUBLIC src sdk/include)
target_link_libraries(gm_registry PUBLIC gm_storage PRIVATE dl)
add_library(gm_flecs STATIC third_party/flecs/flecs.c)
target_include_directories(gm_flecs SYSTEM PUBLIC third_party/flecs)
target_compile_definitions(gm_flecs PUBLIC FLECS_CUSTOM_BUILD FLECS_CPP FLECS_SYSTEM FLECS_PIPELINE FLECS_OS_API_IMPL)
add_library(gm_runtime STATIC src/compiled_ui.cpp src/runtime_document.cpp src/runtime_layout.cpp)
target_include_directories(gm_runtime PUBLIC src)
add_library(gm_render_assets STATIC src/render_assets.cpp)
target_include_directories(gm_render_assets PUBLIC src sdk/include)
add_library(gm_scene STATIC src/scene.cpp src/scene_binary.cpp src/scene_catalog.cpp src/checkpoint.cpp)
target_link_libraries(gm_scene PUBLIC gm_runtime gm_registry gm_tasks gm_render_assets PRIVATE gm_flecs)
set(BX_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/bx")
set(BIMG_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/bimg")
set(BGFX_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/bgfx")
set(BGFX_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BGFX_BUILD_EXAMPLE_COMMON OFF CACHE BOOL "" FORCE)
set(BGFX_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(BGFX_INSTALL OFF CACHE BOOL "" FORCE)
set(BGFX_CUSTOM_TARGETS OFF CACHE BOOL "" FORCE)
set(BGFX_CONFIG_VIDEO OFF CACHE BOOL "" FORCE)
set(BIMG_CONFIG_PARSE_ENABLE OFF CACHE BOOL "" FORCE)
add_subdirectory(third_party/bgfx.cmake EXCLUDE_FROM_ALL)
add_library(gm_renderer STATIC src/renderer.cpp src/portable_font.cpp)
target_include_directories(gm_renderer PUBLIC src PRIVATE "${BGFX_DIR}/examples/common/imgui" "${BGFX_DIR}/3rdparty/stb")
target_link_libraries(gm_renderer PUBLIC bgfx bx PRIVATE android log)
add_library(gm_runtime_view STATIC src/runtime_view.cpp)
target_link_libraries(gm_runtime_view PUBLIC gm_runtime gm_renderer)
add_library(gm_scene_view STATIC src/scene_view.cpp src/world_renderer.cpp)
target_link_libraries(gm_scene_view PUBLIC gm_scene gm_runtime_view)
add_library(gm_native_glue STATIC "${ANDROID_NDK}/sources/android/native_app_glue/android_native_app_glue.c")
target_include_directories(gm_native_glue PUBLIC "${ANDROID_NDK}/sources/android/native_app_glue")
add_library(gm_android SHARED platform/android/player.cpp ${GM_ANDROID_GAME_SOURCES})
target_link_libraries(gm_android PRIVATE gm_scene_view gm_native_glue android log EGL GLESv3)
target_link_options(gm_android PRIVATE "-uANativeActivity_onCreate" "-Wl,-z,max-page-size=16384")
