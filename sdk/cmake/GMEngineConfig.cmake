get_filename_component(GMEngine_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET GMEngine::SDK)
  add_library(GMEngine::SDK INTERFACE IMPORTED)
  set_target_properties(GMEngine::SDK PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${GMEngine_SDK_ROOT}/include" INTERFACE_COMPILE_FEATURES cxx_std_20)
endif()
function(gm_add_game_module target)
  add_library(${target} SHARED ${ARGN})
  target_link_libraries(${target} PRIVATE GMEngine::SDK)
  set_target_properties(${target} PROPERTIES PREFIX "")
  set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  if(MSVC)
    target_compile_options(${target} PRIVATE /utf-8 /W4 /permissive- /Zc:__cplusplus)
  endif()
endfunction()
